(** Extract the interpreter, not a selected source program. Host code only
    parses inputs, supplies entropy, schedules unbounded runs and reports. *)
From Coq Require Import Extraction ExtrOcamlBasic.
From ITree.Indexed Require Import Sum.
From PTree.Core Require Import PTreeDefinition.
From PTree.Examples.PGCL Require Import Frontend Interpretation Probability.
From PTree.Examples.PGCL Require Import Syntax.
From PTree.Prob.Backend.SubEnumQ Require Import Representation.
From PTree.Execution Require Import Runner.
From PTree.Execution.Backend Require Import RationalTickets.

Definition start (c : pgcl) (s : store) : ptree void1 SubEnumQ store :=
  Interpretation.run rational_coin c s.

Definition bounded {Seed} (next : nat -> Seed -> option nat * Seed)
    fuel (c : pgcl) s seed :=
  Runner.run (fun X => @ticket_sample Seed X next) fuel (start c s) seed.

Definition machine_step {Seed} (next : nat -> Seed -> option nat * Seed)
    (t : ptree void1 SubEnumQ store) (seed : Seed) :=
  runner_step (fun X => @ticket_sample Seed X next) t seed.

Extraction Language OCaml.
Set Warnings "-extraction-reserved-identifier".
Extraction "pgcl.ml" compile initial_store start bounded machine_step.
